# ─────────────────────────────────────────────
#  RaPaX™ Environment Configuration
# ─────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
OPERATOR_SECRET=change_this_to_a_long_random_string

# Database
DB_PATH=./rapax.db

# Storage Paths
PRODUCTS_DIR=./storage/products
FINGERPRINTED_DIR=./storage/fingerprinted
LOGS_DIR=./logs

# JWT
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=24h

# Download Link TTL (seconds)
DOWNLOAD_LINK_TTL=3600

# AcerbE™ Fingerprinting Service
ACERBE_BASE_URL=http://localhost:5000
ACERBE_API_KEY=acerbe_api_key_here

# ─── Blockchain Providers ─────────────────────

# BTC (BlockCypher or your own node)
BTC_NETWORK=mainnet
BTC_API_PROVIDER=blockcypher
BTC_API_TOKEN=your_blockcypher_token
BTC_XPUB=your_btc_xpub_key

# ETH (Alchemy / Infura / own node)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETH_CONFIRMATIONS_REQUIRED=2

# SOL (Helius / QuickNode / own node)
SOL_RPC_URL=https://api.mainnet-beta.solana.com
SOL_CONFIRMATIONS_REQUIRED=1

# USDT (ERC20 — same provider as ETH)
USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# ─── CARD PAYMENTS (Stripe Checkout; USD + CAD) ──────────
# Webhook endpoint to create in Stripe: <PUBLIC_BASE_URL>/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
FIAT_ENABLED=false
# STRIPE_SECRET_KEY=            (sk_live_… or a restricted key with Checkout Sessions: write)
# STRIPE_WEBHOOK_SECRET=        (whsec_… from the webhook endpoint)
# PUBLIC_BASE_URL=https://your-store-domain   (no trailing slash; used for Stripe return URLs)

# ─── ENABLED PAYMENT RAILS ──────────
# Only rails that are fully configured are offered; others are dropped with a log line.
# ENABLED_CURRENCIES=USD,CAD,XRP,BTC,SOL
# XRP_WALLET=r…   (receiving account; buyers pay with a unique destination tag)
# SOL_WALLET=…    (receiving wallet; orders are matched by unique exact amount)
# SOL_RPC_URL=    (use a keyed RPC such as Helius/Alchemy; the public endpoint rate-limits)
# BTC_XPUB=zpub…  (PUBLIC account key only — never an xprv/zprv or seed)
# BTC_NETWORK=main
# SEED_DEMO=false (never true in production)
